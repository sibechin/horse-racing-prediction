# Streamlit Secrets の例
# このファイルをコピーして .streamlit/secrets.toml として使用
# secrets.toml は .gitignore に含まれています

[passwords]
# ユーザー名 = "パスワード"
admin = "your_secure_password_here"
user1 = "another_password"

[api_keys]
# JRA-VAN API キー（もしあれば）
jravan = "your_jravan_api_key"

[database]
# データベース接続（必要な場合）
# url = "postgresql://user:password@host:port/dbname"

[model]
# モデル設定
path = "data/models/ensemble"
version = "v2.1"
